{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/www/src/content/docs/**",
				"$TURBO_ROOT$/www/src/sidebar.ts",
				"$TURBO_ROOT$/www/src/site.ts"
			],
			"outputs": ["dist/**"]
		},
		"typecheck": { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/scripts/**"] },
		"test": {
			"dependsOn": ["build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/.github/scripts/**",
				"$TURBO_ROOT$/README.md",
				"$TURBO_ROOT$/www/src/content/docs/**"
			]
		},
		"dev": { "cache": false, "persistent": true }
	}
}
