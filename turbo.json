{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
		"typecheck": { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/scripts/**"] },
		"test": { "dependsOn": ["build"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/scripts/**"] },
		"dev": { "cache": false, "persistent": true }
	}
}
