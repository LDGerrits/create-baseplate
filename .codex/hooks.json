{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash|apply_patch",
				"hooks": [
					{
						"type": "command",
						"command": "cd \"$(git rev-parse --show-toplevel)\" && mise exec -- node .agents/hooks/guard.ts"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "cd \"$(git rev-parse --show-toplevel)\" && node .agents/hooks/rogen-check.mjs"
					},
					{
						"type": "command",
						"command": "cd \"$(git rev-parse --show-toplevel)\" && mise exec -- node .agents/hooks/check.ts",
						"timeout": 180
					}
				]
			}
		]
	}
}
