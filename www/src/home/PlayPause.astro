---
// Pauses an animation that plays by itself.
const { id } = Astro.props;
---
<button class="ctl" id={id} type="button" data-state="playing">
	<svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"
		><rect x="2" y="1.5" width="2.6" height="9" rx="0.6"></rect><rect x="7.4" y="1.5" width="2.6" height="9" rx="0.6"
		></rect></svg
	>
	<svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"
		><path d="M3 1.6v8.8a.5.5 0 0 0 .76.43l7-4.4a.5.5 0 0 0 0-.86l-7-4.4A.5.5 0 0 0 3 1.6z"></path></svg
	>
	<span>Pause</span>
</button>
