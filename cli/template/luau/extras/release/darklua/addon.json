{
	"dependencies": {},
	"imports": {},
	"replaceText": [
		{
			"file": ".gitignore",
			"from": "# Built places\n/build\n",
			"to": "# Built places, and the code Darklua processed for the release (mise run release)\n/build\n/dist\n"
		},
		{
			"file": ".styluaignore",
			"from": "/build\n",
			"to": "/build\n/dist\n"
		},
		{
			"file": ".github/workflows/ci.yml",
			"from": "      - run: mise run ci\n",
			"to": "      - run: mise run ci\n      - run: mise run release\n"
		},
		{
			"file": "mise.toml",
			"from": "depends = [\"build\"]\nenv = { _.file = \".env\" }\nrun = 'node scripts/each-place.ts \"node {root}/scripts/publish.ts build/game.rbxl\"'",
			"to": "depends = [\"release\"]\nenv = { _.file = \".env\" }\nrun = 'node scripts/each-place.ts \"node {root}/scripts/publish.ts build/release.rbxl\"'"
		},
		{
			"file": "mise.toml",
			"from": "Build the game and publish it",
			"to": "Build the release (mise run release) and publish it"
		}
	]
}
