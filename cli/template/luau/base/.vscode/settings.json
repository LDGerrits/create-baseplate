{
	"editor.defaultFormatter": "biomejs.biome",
	"editor.formatOnSave": true,
	"[luau]": { "editor.defaultFormatter": "JohnnyMorganz.stylua" },
	"files.eol": "\n",
	"luau-lsp.platform.type": "roblox",
	"luau-lsp.diagnostics.strictDatamodelTypes": true,
	"luau-lsp.sourcemap.rojoProjectFile": "game.project.json",
	"luau-lsp.sourcemap.includeNonScripts": true,
	"luau-lsp.ignoreGlobs": ["**/Packages/**", "**/ServerPackages/**", "**/DevPackages/**", "**/node_modules/**"],
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"*.luau": "${capture}.spec.luau, ${capture}.engine.spec.luau, ${capture}.story.luau",
		"package.json": "pnpm-lock.yaml, pnpm-workspace.yaml",
		"wally.toml": "wally.lock",
		"selene.toml": "stylua.toml, .styluaignore, .luaurc, biome.json, jest.config.ts",
		".env.example": ".env",
		"mise.toml": "rbx-forge.config.ts, default.rogen.json"
	},
	"search.exclude": {
		"Packages": true,
		"ServerPackages": true,
		"DevPackages": true,
		"build": true,
		".luau-lsp": true,
		"sourcemap.json": true,
		"default.project.json": true,
		"game.project.json": true
	}
}
