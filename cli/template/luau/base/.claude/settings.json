{
	"permissions": {
		"allow": [
			"Bash(mise run *)",
			"Bash(mise tasks *)",
			"Bash(rogen check *)",
			"Bash(rogen where *)",
			"Bash(rogen write *)",
			"Bash(rogen doc *)",
			"Bash(rogen help *)",
			"Bash(rogen serve *)",
			"Bash(forge up *)",
			"Bash(forge down *)",
			"Bash(forge status *)",
			"Bash(forge restart *)",
			"Bash(ror render *)",
			"Bash(ror diff *)",
			"Bash(mise x -- rogen check *)",
			"Bash(mise x -- rogen where *)",
			"Bash(mise x -- rogen write *)",
			"Bash(mise x -- rogen doc *)",
			"Bash(mise x -- rogen help *)",
			"Bash(mise x -- rogen serve *)",
			"Bash(mise x -- forge up *)",
			"Bash(mise x -- forge down *)",
			"Bash(mise x -- forge status *)",
			"Bash(mise x -- forge restart *)",
			"Bash(mise x -- ror render *)",
			"Bash(mise x -- ror diff *)"
		],
		"deny": [
			"Read(./.env)",
			"Read(./.env.local)",
			"Read(./.env.development)",
			"Read(./.env.production)",
			"Read(./.env.staging)",
			"Read(./.env.test)",
			"Read(./.env.dev)",
			"Read(./.env.prod)",
			"Read(./.env.*.local)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/cloud-setup.sh",
						"timeout": 900
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash|Edit|MultiEdit|Write|NotebookEdit|mcp__.*__(open_cloud_invoke|execute_luau)",
				"hooks": [
					{
						"type": "command",
						"command": "sh \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/run guard.ts claude"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Bash|Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "sh \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/run edited.ts claude",
						"timeout": 30
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "sh \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/run check.ts claude",
						"timeout": 180
					}
				]
			}
		]
	}
}
