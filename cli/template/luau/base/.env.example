# Copy to .env and fill in what you use; git ignores it. Only the tasks that use it read it
# (test:engine, ui, publish, errors and, with Asphalt, assets), and each passes on only its own
# variables (scripts/with-env.ts), so the test key never reaches publishing, nor the publish key the
# tests. That keeps keys from tools that don't need them, not from code run inside a task.
# None is needed for `mise run check`. Each section says which command needs it.

# Open Cloud, for `mise run test:engine` without Studio (jest-roblox).
# Create the key at https://create.roblox.com/dashboard/credentials with the scopes
# universe-places:write and universe.place.luau-execution-session:write on an experience made only
# for tests: a key reaches every place of its experience, so never use the live game's.
ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=

# Open Cloud, for `mise run publish` from your machine; CI's publish workflow has its own, per
# environment. A key with universe-places:write on the experience you publish to, its ID, and the
# place's ID (in a multi-place game, each place's: lobby=123,game=456). Keep it apart from the test
# key above.
ROBLOX_PUBLISH_API_KEY=
ROBLOX_PUBLISH_UNIVERSE_ID=
ROBLOX_PUBLISH_PLACE_ID=

# Open Cloud, for `mise run errors`: it reads the errors first seen in a version, with their stack
# traces, from the experience you publish dev builds to. Read-only: create a key of its own at
# https://create.roblox.com/dashboard/credentials with only the operation universe.analytics:read
# (in the universe-analytics system too, which the error count's query needs) on that experience,
# and never reuse the publish key. Its owner needs analytics access to the experience. The place ID
# is the dev place's (in a multi-place game, each place's: lobby=123,game=456).
ROBLOX_ERRORS_API_KEY=
ROBLOX_ERRORS_UNIVERSE_ID=
ROBLOX_ERRORS_PLACE_ID=

# WSL only: Windows Studio for `mise run test:engine`, as /mnt/c/... paths.
# JEST_ROBLOX_STUDIO_PATH=/mnt/c/Users/<you>/AppData/Local/Roblox/Versions/<version>/RobloxStudioBeta.exe
# JEST_ROBLOX_PLUGINS_DIR=/mnt/c/Users/<you>/AppData/Local/Roblox/Plugins

# Neither Windows nor WSL: a copy of Studio's content folder, so `mise run ui` can draw text.
# RUR_ROBLOX_CONTENT=
