{
	"version": 1,
	"hooks": {
		"preToolUse": [
			{
				"command": "mise exec --quiet -- node .agents/hooks/guard.ts cursor"
			}
		],
		"beforeMCPExecution": [
			{
				"command": "mise exec --quiet -- node .agents/hooks/guard.ts cursor"
			}
		],
		"afterFileEdit": [
			{
				"command": "mise exec --quiet -- node .agents/hooks/edited.ts cursor",
				"timeout": 30
			}
		],
		"stop": [
			{
				"command": "mise exec -- node .agents/hooks/rogen-check.mjs cursor"
			},
			{
				"command": "mise exec --quiet -- node .agents/hooks/check.ts cursor",
				"timeout": 180
			}
		]
	}
}
