{
	"editor.defaultFormatter": "biomejs.biome",
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit", "source.fixAll.eslint": "explicit" },
	"files.eol": "\n",
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.expand": false,
	"explorer.fileNesting.patterns": {
		"*.ts": "${capture}.spec.ts, ${capture}.engine.spec.ts",
		"*.tsx": "${capture}.story.tsx, ${capture}.spec.ts, ${capture}.spec.tsx",
		"package.json": "pnpm-lock.yaml, pnpm-workspace.yaml",
		"tsconfig.json": "tsconfig.*.json, rotor.toml, eslint.config.ts, biome.json, jest.config.ts",
		"*.rogen.json": "${capture}.project.json, test.${capture}.project.json, game.project.json, test.project.json",
		"mise.toml": "mise.lock, rbx-forge.config.ts, asphalt.toml, .darklua.json, *.rbxlx, *.rbxlx.lock, *.rbxl.lock",
		"selene.toml": "stylua.toml, .luaurc",
		".gitignore": ".gitattributes, .editorconfig, .worktreeinclude",
		".env.example": ".env, .env.*"
	},
	"files.exclude": {
		".rotor": true,
		"include": true,
		"flamework.build": true,
		"**/.eslintcache": true,
		"**/.forge": true,
		"**/.jest-roblox": true
	},
	"search.exclude": {
		"out": true,
		"build": true,
		"projects/*/build": true,
		"*.project.json": true,
		"projects/*/*.project.json": true
	}
}
