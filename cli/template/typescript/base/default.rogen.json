{
	"name": "my-game",
	"sourcePaths": ["src"],
	"routes": {
		"server": "ServerScriptService",
		"client": "StarterPlayer/StarterPlayerScripts",
		"shared": "ReplicatedStorage/shared"
	},
	"compiledPath": "out",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"rbxts_include": {
				"node_modules": {
					"$className": "Folder",
					"@flamework": {
						"$path": "node_modules/@flamework"
					},
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@rbxts-js": {
						"$path": "node_modules/@rbxts-js"
					}
				},
				"$path": {
					"optional": "include"
				}
			}
		}
	}
}
