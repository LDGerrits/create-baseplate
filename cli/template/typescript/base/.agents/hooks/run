#!/bin/sh
# Starts one of this folder's hooks with the project's pinned Node, for every agent tool:
#   .agents/hooks/run guard.ts <format>
# It runs from the project folder whichever folder the tool started it in, and finds mise on the
# PATH or where mise's installer puts it (~/.local/bin), which apps started outside a shell may not
# have on their PATH. Without mise, or when the hook itself fails, it lets the agent carry on rather
# than blocking every command, except the guard: it still blocks Studio's live tools and publishing,
# which nothing else stops.
hook=$1
shift
input=$(cat)

failed() {
	[ "$hook" = guard.ts ] || exit 0
	# Only the tool's name and its command, which Copilot sends inside a JSON string.
	printf '%s' "$input" | grep -Eq '"(tool_name|toolName)" *: *"[^"]*(open_cloud_invoke|execute_luau)"|command\\?" *: *\\?"[^"\\]*(mise[^"\\]* +publish|publish\.ts|rojo +upload)' || exit 0
	reason="The guard could not run (is mise installed?), so this call is blocked: it can act on the live game. Tell the user."
	case $1 in
	cursor) printf '{"permission":"deny","agent_message":"%s","user_message":"%s"}\n' "$reason" "$reason" ;;
	copilot) printf '{"permissionDecision":"deny","permissionDecisionReason":"%s"}\n' "$reason" ;;
	gemini) printf '{"decision":"deny","reason":"%s"}\n' "$reason" ;;
	*) printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$reason" ;;
	esac
	exit 0
}

# Cursor and Copilot also run Claude Code's hooks (.claude/settings.json) besides their own, with
# their own payload (Cursor's fields, or Copilot's numeric timestamp): the Claude copy stands down, or every hook would run twice and the stop check
# would ignore Cursor's limit on follow-ups.
if [ "$1" = claude ] && printf '%s' "$input" | grep -Eq '"(cursor_version|loop_count|toolArgs)" *:|"timestamp" *: *[0-9]'; then
	exit 0
fi

cd "$(dirname "$0")/../.." 2>/dev/null || failed "$@"
if ! mise=$(command -v mise 2>/dev/null); then
	mise="$HOME/.local/bin/mise"
	# The hooks start mise's tools, and mise itself, by name.
	PATH="$PATH:$HOME/.local/bin"
	export PATH
fi
[ -x "$mise" ] || failed "$@"
printf '%s' "$input" | "$mise" exec --quiet -- node ".agents/hooks/$hook" "$@" || failed "$@"
