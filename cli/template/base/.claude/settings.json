{
	"permissions": {
		"allow": [
			"Bash(mise run:*)",
			"Bash(mise tasks:*)",
			"Bash(rogen check:*)",
			"Bash(rogen where:*)",
			"Bash(forge status:*)",
			"Bash(mise x -- rogen check:*)",
			"Bash(mise x -- rogen where:*)",
			"Bash(mise x -- forge status:*)"
		],
		"deny": ["Read(./.env)", "Read(./.env.local)"]
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/cloud-setup.sh",
						"timeout": 900
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "mise exec -C \"$CLAUDE_PROJECT_DIR\" -- node \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/guard.ts"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "mise exec -C \"$CLAUDE_PROJECT_DIR\" -- node \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/rogen-check.mjs"
					},
					{
						"type": "command",
						"command": "mise exec -C \"$CLAUDE_PROJECT_DIR\" -- node \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/check.ts",
						"timeout": 180
					}
				]
			}
		]
	}
}
