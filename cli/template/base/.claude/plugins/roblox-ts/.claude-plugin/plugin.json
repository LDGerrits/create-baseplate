{
	"name": "roblox-ts",
	"description": "The project's own TypeScript language server, so Claude sees type errors after each edit",
	"version": "1.0.0",
	"lspServers": {
		"typescript": {
			"command": "node",
			"args": ["${CLAUDE_PROJECT_DIR}/node_modules/typescript-language-server/lib/cli.mjs", "--stdio"],
			"extensionToLanguage": {
				".ts": "typescript",
				".tsx": "typescriptreact"
			}
		}
	}
}
