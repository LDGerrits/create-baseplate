{
	"name": "create-baseplate",
	"version": "0.0.0",
	"description": "Create a roblox-ts game set up for coding agents",
	"license": "MIT",
	"type": "module",
	"bin": {
		"create-baseplate": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20.12"
	},
	"scripts": {
		"build": "tsup && node scripts/copyTemplate.ts",
		"dev": "tsup --watch",
		"typecheck": "tsc",
		"test": "node --test test/*.test.ts",
		"start": "node dist/index.js"
	},
	"dependencies": {
		"@clack/prompts": "1.8.1",
		"commander": "15.1.0",
		"picocolors": "1.1.1"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"tsup": "9.0.0",
		"typescript": "6.0.3"
	}
}
