{
	"name": "create-baseplate",
	"version": "0.0.0",
	"description": "Create a Roblox game, in roblox-ts or Luau, set up for coding agents",
	"keywords": [
		"roblox-ts",
		"rbxts",
		"luau",
		"roblox",
		"create",
		"scaffold",
		"agents",
		"claude-code",
		"codex",
		"cursor"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LDGerrits/create-baseplate.git",
		"directory": "cli"
	},
	"homepage": "https://github.com/LDGerrits/create-baseplate#readme",
	"bugs": "https://github.com/LDGerrits/create-baseplate/issues",
	"type": "module",
	"bin": {
		"create-baseplate": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"build": "tsup && node scripts/copyTemplate.ts && node scripts/copyDocs.ts",
		"prepack": "pnpm run build",
		"dev": "tsup --watch",
		"typecheck": "tsc",
		"test": "node --test test/*.test.ts",
		"start": "node dist/index.js"
	},
	"dependencies": {
		"@clack/prompts": "1.8.1",
		"commander": "15.1.0",
		"cross-spawn": "7.0.6",
		"picocolors": "1.1.1"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/node": "24.19.2",
		"tsup": "9.0.0",
		"typescript": "6.0.3"
	}
}
