# Copy to .env and fill in what you use; mise loads .env into every task, and git ignores it.
# None is needed for `mise run check`. Each section says which command needs it.

# Open Cloud, for `mise run test:engine` without Studio (jest-roblox).
# Create the key at https://create.roblox.com/dashboard/credentials with the scopes
# universe-places:write and universe.place.luau-execution-session:write on a place made for tests.
ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=

# WSL only: Windows Studio for `mise run test:engine`, as /mnt/c/... paths.
# JEST_ROBLOX_STUDIO_PATH=/mnt/c/Users/<you>/AppData/Local/Roblox/Versions/<version>/RobloxStudioBeta.exe
# JEST_ROBLOX_PLUGINS_DIR=/mnt/c/Users/<you>/AppData/Local/Roblox/Plugins

# Neither Windows nor WSL: a copy of Studio's content folder, so `mise run ui` can draw text.
# RUR_ROBLOX_CONTENT=
