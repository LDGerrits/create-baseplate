{
	"permissions": {
		"allow": [
			"Bash(mise run:*)",
			"Bash(mise tasks:*)",
			"Bash(rogen check:*)",
			"Bash(rogen where:*)",
			"Bash(forge status:*)"
		],
		"deny": ["Read(./.env)", "Read(./.env.local)"]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "mise exec -C \"$CLAUDE_PROJECT_DIR\" -- node \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/guard.ts"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/rogen-check.mjs"
					},
					{
						"type": "command",
						"command": "mise exec -C \"$CLAUDE_PROJECT_DIR\" -- node \"$CLAUDE_PROJECT_DIR\"/.agents/hooks/check.ts",
						"timeout": 180
					}
				]
			}
		]
	}
}
